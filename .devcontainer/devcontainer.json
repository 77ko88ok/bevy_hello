{
  "name": "Bevy 0.20 WASM Environment",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "rust-lang.rust-analyzer",
        "tamasfe.even-better-toml",
        "serayuzgur.crates"
      ]
    }
  },
  "forwardPorts": [8080],
  "portsAttributes": {
    "8080": {
      "label": "Trunk Dev Server",
      "onAutoForward": "openBrowser"
    }
  },
  "remoteUser": "vscode"
}
